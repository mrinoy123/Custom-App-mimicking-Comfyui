# ==========================================
# Custom ComfyUI Micro-Engine Environment Configuration
# ==========================================

# 1. Aiven Cloud PostgreSQL Database (Optional - Fallback to local files if empty)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=

# 2. Cloudflare R2 Object Storage (Optional - Fallback to local outputs/ if empty)
# Used for storing generated PNG images and MP4 videos with $0 egress bandwidth fees
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=comfy-media
R2_PUBLIC_DOMAIN=https://pub-your-id.r2.dev

# 3. Execution & Server Settings
PORT=8000
HOST=0.0.0.0
LOCAL_OUTPUT_DIR=outputs
WORKFLOWS_DIR=workflows
